# Copy this file to .env and fill in real values before running docker-compose

# Optional — only needed if you add these providers later (Phase 2+).
# The Phase 1 stock data service uses yfinance, which needs no API key.
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
NEWS_API_KEY=

# LLM provider for the AI agent (Phase 3)
ANTHROPIC_API_KEY=

# Database (docker-compose sets this automatically for containers;
# override here only for local, non-docker development)
DATABASE_URL=postgresql://stockintel:stockintel@localhost:5432/stockintel
